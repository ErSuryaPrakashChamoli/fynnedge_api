# FynnEdge API — environment
#
# Copy to .env for local development. The values below are the safe ones;
# every line marked PRODUCTION must be changed before deploying, and the
# checks in tests/Feature/ProductionConfigTest.php assert the ones that can
# be verified from inside the application.

APP_NAME=FynnEdge
APP_ENV=local
APP_KEY=
APP_URL=http://localhost:8000

# PRODUCTION: must be false. With debug on, every error response carries the
# exception class, the file path, the line and a full stack trace.
APP_DEBUG=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# PRODUCTION: use `info` or higher. `debug` is noisy and more likely to
# capture something that should not be kept.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PRODUCTION: a managed database, not the local SQLite file.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Document reading runs on the queue so a provider taking its time on a
# large file cannot hold a customer's request open. `sync` runs it inline,
# which is what development and the test suite use; `database` needs a
# worker (`php artisan queue:work`) and is what production wants.
#
# The worker re-checks consent, the document's existence and its bytes
# before sending anything — a job that trusted the state at enqueue time
# would send a document somebody had since said it must not send.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@fynnedge.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- FynnEdge ---------------------------------------------------------------

# OTP delivery. `log` writes the code to the Laravel log and returns it to the
# app so the OTP screen works without an SMS gateway. It refuses to run when
# APP_ENV=production, so a real driver must be configured before deploying.
# PRODUCTION: a real SMS provider.
# Which proxies may set X-Forwarded-For and X-Forwarded-Proto.
#
# Empty means trust none, which is right for PHP reached directly and wrong
# for every deployment behind a load balancer, CDN or ingress: without it
# every customer presents as the proxy's own address, so the per-address OTP
# limits are shared by the whole user base and TLS is not detected.
#
# Set it to the proxy addresses or CIDR ranges, comma-separated. "*" trusts
# any proxy and is only safe when nothing but the load balancer can reach
# this application — otherwise a caller can claim any address and step
# around the per-address limits.
TRUSTED_PROXIES=

FYNNEDGE_OTP_DRIVER=log
FYNNEDGE_OTP_TTL=300

# The development customer DemoCustomerSeeder creates. Nothing in the request
# path reads this — who a request belongs to comes from the Sanctum token.
# The seeder itself refuses to run in production.
FYNNEDGE_DEMO_MOBILE=9876543210

# Which catalogue answers customer product requests.
#   sample    the six fictional products written into MockProductRepository
#   database  the persisted catalogue, administered via `fynn:catalogue`
# The default is sample, so a deployment that has never populated the
# catalogue still works and still says its products are invented.
FYNNEDGE_CATALOGUE_DRIVER=sample

# Provider integration.
#
# NO LIVE PROVIDER IS CONNECTED TO FYNNEDGE. `fixture` is a fictional
# provider used to prove the ingestion boundary works; nothing it does
# reaches a network, and every product it creates carries a sample
# provenance so it can never be shown as a real offer.
#
# PRODUCTION: when a real provider contract exists it gets its own driver
# value and its credentials go here as their own variables — never in this
# file, and never inside a product record. Two rules hold on that day:
#   - production must not run on `fixture`;
#   - a real provider failing is never permission to fall back to fixture or
#     sample data. There is no fallback, deliberately.
FYNNEDGE_PROVIDER_DRIVER=fixture

# Seconds. Bounded so an ingestion run cannot hang.
FYNNEDGE_PROVIDER_TIMEOUT=15

# Credit bureau.
#
# NO LIVE BUREAU IS CONNECTED TO FYNNEDGE. There is no CIBIL, Experian,
# Equifax or CRIF contract behind this product. `none` is the default and
# means the capability does not exist: the credit-check consent is not even
# offered, because a consent is only shown when the thing it authorises is
# real.
#
#   none      no bureau. No consent offered, no endpoint that can succeed.
#   fixture   a fictional bureau, for proving the boundary in tests.
#
# PRODUCTION, on the day a real bureau contract exists:
#   - production must not run on `fixture`;
#   - credentials go here as their own variables, never in this file;
#   - a bureau failing is never permission to invent, assume or reuse a
#     score. There is no fallback, deliberately;
#   - the enquiry type (soft/hard) and the retention period must be read
#     out of that contract before launch. FynnEdge currently makes no
#     promise about either, because it has no contract to make one from.
FYNNEDGE_CREDIT_DRIVER=none

# Seconds. Bounded so a bureau request cannot hang a customer's screen.
FYNNEDGE_CREDIT_TIMEOUT=15

# Days a report already held is reused instead of asking again. A pull may
# cost money and may be recorded as an enquiry against the customer, so the
# default is not zero. A real contract replaces this figure.
FYNNEDGE_CREDIT_REUSE_DAYS=30

# Checks per customer per hour. A person tapping a button three times must
# not become three enquiries.
FYNNEDGE_CREDIT_CHECKS_PER_HOUR=5

# FynnScan — document understanding.
#
# NO LIVE DOCUMENT PROVIDER IS CONNECTED TO FYNNEDGE. There is no OCR or
# document-intelligence contract behind this product. `none` is the default
# and means the capability does not exist: the document-processing consent is
# not offered, and a scan request answers 501.
#
#   none      no provider. Documents are stored and never read.
#   fixture   a fictional provider, for proving the boundary in tests.
#
# PRODUCTION, on the day a real provider contract exists:
#   - production must not run on `fixture`;
#   - credentials go here as their own variables, never in this file;
#   - a provider failing is never permission to invent, guess or reuse an
#     extraction. There is no fallback, deliberately;
#   - a worker must be running. Reading is queued, and the worker re-checks
#     consent, the document and its bytes before sending anything. Set
#     QUEUE_CONNECTION=database and run `php artisan queue:work`;
#   - a malware scanner must exist. This is enforced, not advisory: a real
#     provider cannot receive a document until a scanner has passed it —
#     see FYNNEDGE_MALWARE_SCANNER below;
#   - these must be read out of the provider contract before launch and are
#     currently all unknown: whether the provider stores the document, for
#     how long, whether it trains on it, how deletion is requested, and in
#     which region it is processed.
FYNNEDGE_SCAN_DRIVER=none

# Which behaviour the fictional provider plays: good, low_confidence,
# missing_field, conflicting_field, ambiguous_amount, ambiguous_date,
# misclassified, unreadable, unreadable_document, unsupported_document,
# provider_unavailable, provider_timeout.
#
# Server-side only. A request cannot choose it, because a customer choosing
# their own extraction would defeat the point of having one.
FYNNEDGE_SCAN_FIXTURE_SCENARIO=good

# Seconds. Bounded so a provider cannot hang a customer's screen. Enforced by
# a real adapter's HTTP client; the fixture does no I/O.
FYNNEDGE_SCAN_TIMEOUT=30

# Readings per customer per hour. Document intelligence is billed per page by
# every provider that sells it, so a looping client must not become a looping
# charge. Ten is a development figure; the real one comes from a contract
# that does not exist yet.
FYNNEDGE_SCAN_PER_HOUR=10

# KYC — identity and document verification.
#
# NO LIVE KYC PROVIDER IS CONNECTED TO FYNNEDGE. There is no identity
# verification contract behind this product. `none` is the default and means
# the capability does not exist: the identity-verification consent is not
# offered, and a verification request answers 501.
#
#   none      no provider. Documents are stored and never verified.
#   fixture   a fictional service, for proving the boundary in tests.
#
# There is deliberately NO FALLBACK. A deployment configured for a real
# provider whose adapter or credentials are absent answers
# verification_not_configured rather than quietly using the fixture. A
# synthetic "verified" shown as a real one is the worst failure available
# here.
#
# AADHAAR. FynnEdge does not and must not perform Aadhaar authentication or
# e-KYC. That is a regulated operation carried out by authorised requesting
# entities with defined ecosystem roles and explicit resident authorisation,
# and FynnEdge holds none of them. UIDAI publishing interfaces and developer
# material is not permission to call them, and a developer sandbox is not
# production authorisation. A future integration goes through an authorised
# partner and arrives here as an ordinary adapter. See
# App\Domain\Kyc\AadhaarBoundary.
#
# PRODUCTION, on the day a real provider contract exists — every one of
# these must be known before this is switched on:
#   - the provider's legal entity and its authorisation basis;
#   - the API contract and its data-processing terms;
#   - retention, deletion, and whether submitted documents train a model;
#   - processing location and sub-processors;
#   - security controls, incident handling and auditability;
#   - webhook authentication and signature verification, if callbacks are
#     used — an unauthenticated callback that can set "verified" is a way to
#     verify anybody;
#   - SLA, timeout behaviour, rate limits and pricing.
# None of these is known today, so KYC is not production-ready and this
# report does not claim it is.
FYNNEDGE_KYC_DRIVER=none

# Which behaviour the fictional service plays: verified, name_mismatch,
# document_not_verified, document_tampered, ambiguous, no_identity_returned,
# unreadable, unreadable_document, unsupported_document,
# provider_unavailable, provider_timeout.
#
# Server-side only. A request cannot choose it, because a customer choosing
# `verified` would be issuing their own verification.
FYNNEDGE_KYC_FIXTURE_SCENARIO=verified

# Seconds. Bounded so a provider cannot hang a customer's screen.
FYNNEDGE_KYC_TIMEOUT=30

# Verifications per customer per hour. Identity checks are billed per call by
# every provider that sells them. Five is a development figure; the real one
# comes from a contract that does not exist yet.
FYNNEDGE_KYC_CHECKS_PER_HOUR=5

# Lender application submission.
#
# NO LIVE SUBMISSION PROVIDER IS CONNECTED TO FYNNEDGE. There is no lender,
# gateway, aggregator, DSA or LOS integration behind this product. `none` is
# the default and means the capability does not exist: the submission consent
# is not offered, and a submission answers 501.
#
#   none      no provider. Applications are recorded and sent nowhere.
#   fixture   a fictional provider, for proving the boundary in tests. It
#             REFUSES TO RUN IN PRODUCTION — see below.
#
# There is deliberately NO FALLBACK. A deployment configured for a real
# provider whose adapter or credentials are absent answers
# lender_provider_unavailable rather than quietly simulating a submission.
#
# THE PRODUCTION GUARD. This is the one fixture in FynnEdge whose output
# could make a customer believe they have applied for a loan. Every other
# simulated capability degrades into "we could not do that"; this one,
# misread, degrades into a person waiting for a lender who has never heard
# of them. So it does not merely label itself — FixtureLenderSubmissionProvider
# reports itself unavailable when APP_ENV=production, and refuses to run even
# if reached directly. There is no escape hatch.
#
# PRODUCTION, on the day a real submission contract exists — every one of
# these must be known before this is switched on:
#   - the provider's legal entity and its contractual role. A gateway, an
#     aggregator or a DSA is NOT a lender, and the UI must say which it is;
#   - the lender(s) actually reached through it;
#   - the API contract, sandbox and production, and its field requirements;
#   - what the provider does on a duplicate submission, and whether it
#     supports idempotency keys;
#   - whether it supports status lookup, so an unknown outcome can be
#     reconciled rather than left uncertain;
#   - webhook authentication (HMAC, mTLS, signed JWT) if callbacks exist —
#     an unauthenticated callback that can set "approved" is a way to
#     approve anybody;
#   - data-processing terms, retention, deletion and sub-processors;
#   - SLA, rate limits, timeout semantics and pricing.
# None of these is known today, so submission is not production-ready and
# the Module 26 report does not claim it is.
FYNNEDGE_LENDER_DRIVER=none

# Which behaviour the fictional provider plays: simulated,
# rejected_by_gateway, provider_unavailable, rate_limited, timeout_after_send.
#
# There is deliberately no `provider_received` and no `approved` scenario: a
# fictional provider has received nothing and decided nothing.
#
# Server-side only. A request cannot choose it.
FYNNEDGE_LENDER_FIXTURE_SCENARIO=simulated

# Seconds. Bounded so a provider cannot hang a customer's screen.
FYNNEDGE_LENDER_TIMEOUT=30

# Submission attempts per customer per hour. The strictest limiter in the
# API: each attempt may create an application at an external party, a cost
# measured in a customer's credit record rather than in money. Three is a
# development figure.
FYNNEDGE_LENDER_PER_HOUR=3

# Provider events — callbacks about applications already submitted.
#
# NO LIVE PROVIDER EVENT SOURCE IS CONNECTED TO FYNNEDGE. There is no
# webhook contract, no signing secret, no endpoint documentation and no
# provider, so there is nothing to receive events from. `none` is the
# default and means the allowlist is empty: every provider code is a 404,
# including one an attacker guesses.
#
#   none      no event source. Nothing can report anything.
#   fixture   a simulated source, for proving the ingress boundary in
#             tests. Absent from the allowlist in production regardless of
#             this setting, so a simulated delivery cannot reach a real
#             customer's application there by any route.
#
# THE INGRESS IS NOT A CUSTOMER ENDPOINT. It sits outside auth:sanctum
# deliberately: a customer's token authenticates nothing there, and a
# provider callback carries no customer session. A route that accepted
# either would let a customer report their own approval.
#
# PRODUCTION, on the day a real provider contract exists — from that
# contract and not guessed at in advance:
#   - the authentication scheme (HMAC over the body, an asymmetric
#     signature, mTLS, a signed JWT) and its credentials, which go here as
#     their own variables and never in this file;
#   - the event vocabulary and payload shape, which get their own
#     normalizer;
#   - whether the provider issues event ids, and what it does on redelivery;
#   - whether it supplies a sequence number — FynnEdge orders by event
#     meaning today because nothing better is available, and a real sequence
#     number is strictly better;
#   - its replay window, if the contract defines one;
#   - its delivery and retry behaviour, which decides the rate limit below.
FYNNEDGE_PROVIDER_EVENTS_DRIVER=none

# The simulated source's shared secret.
#
# A real check, not a bypass: with no secret configured the fixture
# authenticates nothing. It is emphatically NOT a proposal for what a real
# provider should use.
FYNNEDGE_PROVIDER_EVENTS_FIXTURE_SECRET=

# Deliveries accepted per provider per minute. Generous enough that a
# provider replaying a backlog is not blocked — losing real events to a
# limiter is worse than the traffic — and tight enough that the endpoint is
# not a free amplifier. A real figure comes from a provider's own delivery
# behaviour.
FYNNEDGE_PROVIDER_EVENTS_PER_MINUTE=120

# Malware scanning for customer documents.
#
# NO SCANNER IS CONNECTED. `none` is the default and means nothing has
# looked at any stored file.
#
# THIS IS ENFORCED, NOT ADVISORY. No customer document may be sent to a real
# external provider until a scanner exists and passes it — FynnScan and KYC
# both refuse, and the refusal is tested. A simulated provider sends the
# bytes nowhere and is unaffected: blocking development to protect nobody
# would only teach people to route around the gate.
#
# A scanner that waved everything through would be worse than none: it would
# turn "nobody looked" into "we looked and it was fine" everywhere
# downstream, including in whatever record an incident review would read.
FYNNEDGE_MALWARE_SCANNER=none

# Retention.
#
# Every period is unset, and unset means KEEP. FynnEdge does not choose a
# retention period: how long a credit report, a document extraction, an
# identity verification or an operational event record may be kept is a
# product and legal decision, and a number chosen by an engineer to make a
# table smaller would delete a customer's record on a date nobody agreed.
#
# What exists is the mechanism. `php artisan fynn:retention` reports what is
# held and how old it is; `--apply` deletes only what a configured period
# covers. Setting a value once the decision is taken is then a configuration
# change rather than a project.
#
# Separate from consent withdrawal, which already deletes immediately and
# unconditionally. These govern how long something may be kept while consent
# still stands.
FYNNEDGE_RETAIN_CREDIT_DAYS=
FYNNEDGE_RETAIN_SCAN_DAYS=
FYNNEDGE_RETAIN_KYC_DAYS=
FYNNEDGE_RETAIN_EVENT_DAYS=

# FynnAI. The deterministic assistant answers from the customer's own saved
# figures and is not a language model. `none` binds the unavailable provider,
# which says so plainly rather than pretending.
FYNN_AI_PROVIDER=deterministic

# FynnVault stores documents on a private disk. There is no public URL to a
# document and there must never be one: files are streamed by the controller
# to their authenticated owner.
# PRODUCTION: private object storage, with public access disabled at the
# bucket, not only in application config.

# --- Not verifiable from inside the application -----------------------------
#
# These must be checked in the deployment itself:
#   - TLS terminated in front of the API; HTTP redirected to HTTPS.
#   - TrustProxies configured for the real load balancer, so rate limits and
#     logs see the client IP rather than the proxy's.
#   - Request body size limited at the web server, above the 10 MB FynnVault
#     accepts and well below anything that would exhaust memory.
#   - Object storage bucket private, with no public listing.
#   - Database backups, and a restore that has actually been tested.
#   - Virus scanning on uploaded files. FynnEdge does not scan uploads; it
#     validates type, size and content, and stores under a server-generated
#     key. A scanning layer is a production dependency, not something the
#     application fakes.

# ---------------------------------------------------------------------------
# Push notifications
# ---------------------------------------------------------------------------
#
# NO PUSH PROVIDER IS CONNECTED. There is no FCM integration, no APNs
# integration and no credentials anywhere in this project.
#
#   none    the default. Notifications are recorded and shown in the app;
#           nothing is pushed, and every delivery records "unavailable"
#           rather than a success.
#   mock    simulates a push and says so. Every delivery is recorded as
#           `simulated`, which is a different state from `sent` everywhere
#           it is read. Refused in production.
#
# A real adapter arrives as a third driver implementing
# App\Domain\Notifications\NotificationDeliveryProvider. Its credentials
# belong here, server-side, and never in Flutter.
FYNNEDGE_PUSH_DRIVER=none
